# ============================================
# Misfits-Battle - Production .gitignore
# ============================================

# ============================================
# CRITICAL: Environment & Secrets
# ============================================
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# ============================================
# Python / Django Backend
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/
celerybeat-schedule
celerybeat.pid

# ============================================
# Node / Frontend
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
*.local
.cache/
coverage/
*.tsbuildinfo

# ============================================
# IDE / Editor
# ============================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================
# OS Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# Deployment
# ============================================
.netlify/
.vercel/
.aws/
.terraform/

# ============================================
# Logs & Temporary Files
