logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.swp

# ============================================
# Testing & Coverage
# ============================================
.coverage
.pytest_cache/
htmlcov/
.tox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================
