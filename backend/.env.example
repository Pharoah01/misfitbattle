# ============================================
# Misfits-Battle Backend Environment Variables
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. Never commit .env to Git
#
# cp .env.example .env
# ============================================

# ============================================
# Django Settings
# ============================================
SECRET_KEY=your-super-secret-key-here-generate-new-one-with-django
DEBUG=False
ALLOWED_HOSTS=api.binarymisfits.info,localhost,127.0.0.1

# ============================================
# Frontend URL
# ============================================
FRONTEND_URL=https://yourdomain.com

# ============================================
# Database Configuration
# ============================================
# For SQLite (Small scale - 10-50 users):
USE_POSTGRES=False

# For PostgreSQL (Production - 50+ users):
# USE_POSTGRES=True
# DB_NAME=misfits_battle
# DB_USER=misfits_user
# DB_PASSWORD=your_secure_database_password
# DB_HOST=localhost
# DB_PORT=5432

# ============================================
# Celery Configuration
# ============================================
# Set to False to process submissions synchronously (no Redis/Celery needed)
# Set to True in production to use background task processing
USE_CELERY=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# CORS Configuration
# ============================================
# Add your frontend domains (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Session Security
# ============================================
SESSION_TIMEOUT_MINUTES=30
ENABLE_SUSPICIOUS_LOGIN_DETECTION=True
ENABLE_IP_MONITORING=True

# ============================================
# Gunicorn Workers
# ============================================
# For t3.small (2 vCPU): 3 workers recommended
# For t3.medium (2 vCPU): 4 workers recommended
GUNICORN_WORKERS=3

# ============================================
# External Services
# ============================================
# Heatmap comparison API (optional)
HEATMAP_API_URL=http://localhost:5000
HEATMAP_API_TIMEOUT=30
