# ============================================
# Misfits-Battle Backend Environment Variables
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. Never commit .env to Git
#
# cp .env.example .env
# ============================================

# ============================================
# Django Settings
# ============================================
SECRET_KEY=your-super-secret-key-here-generate-new-one-with-django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-ec2-ip,yourdomain.com

# ============================================
# Database Configuration
# ============================================
# For PostgreSQL (Production):
DB_ENGINE=django.db.backends.postgresql
DB_NAME=misfits_battle
DB_USER=misfits_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PORT=5432

# For SQLite (Development):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Celery Configuration
# ============================================
# Set to False in development to process submissions synchronously (no Redis/Celery needed)
# Set to True in production to use background task processing
USE_CELERY=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# CORS Configuration
# ============================================
# Add your frontend domains (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app,https://yourdomain.com

# ============================================
# File Storage
# ============================================
MEDIA_ROOT=/var/www/misfits-battle/backend/media
MEDIA_URL=/media/
STATIC_ROOT=/var/www/misfits-battle/backend/staticfiles
STATIC_URL=/static/

# ============================================
# External Services (Optional)
# ============================================
# Heatmap comparison API
HEATMAP_API_URL=https://your-heatmap-api.com
HEATMAP_API_KEY=your_api_key_here

# Email configuration (if needed)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# Security Settings (Production)
# ============================================
# Uncomment for production with HTTPS
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True

# ============================================
# Development Settings
# ============================================
# Set to True for local development only
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
