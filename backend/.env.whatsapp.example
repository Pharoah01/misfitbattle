# WhatsApp Security Alerts Configuration
# Copy this to your .env file and configure your preferred WhatsApp API provider

# Enable/Disable WhatsApp alerts
WHATSAPP_ALERTS_ENABLED=true

# WhatsApp API Provider (choose one: 'twilio', 'whatsapp_business', 'ultramsg')
WHATSAPP_API_PROVIDER=twilio

# Admin phone numbers (with country code, comma-separated)
# Example: +1234567890,+9876543210
WHATSAPP_ADMIN_NUMBERS=+916381770117

# Alert thresholds
WHATSAPP_ALERT_THRESHOLD=3

# === TWILIO CONFIGURATION ===
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=AC6541b03baa687c7fd88d1c3dede1188b
TWILIO_AUTH_TOKEN=65e9f270ea2626d28f99cf37b61fa81f
TWILIO_WHATSAPP_NUMBER=+14155238886

# # === WHATSAPP BUSINESS API CONFIGURATION ===
# # Get these from: https://developers.facebook.com/
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# # === ULTRAMSG CONFIGURATION ===
# # Get these from: https://ultramsg.com/
# ULTRAMSG_TOKEN=your_ultramsg_token
# ULTRAMSG_INSTANCE_ID=your_instance_id