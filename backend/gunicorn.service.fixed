[Unit]
Description=Gunicorn daemon for Misfits Battle
Requires=network.target
After=network.target

[Service]
Type=notify
User=root
Group=root
RuntimeDirectory=gunicorn
WorkingDirectory=/opt/misfitbattle/backend
Environment="PATH=/opt/misfitbattle/backend/env/bin"
ExecStart=/opt/misfitbattle/backend/env/bin/gunicorn \
          --config /opt/misfitbattle/backend/gunicorn.conf.py \
          backend.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
