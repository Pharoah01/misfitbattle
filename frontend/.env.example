# ============================================
# Misfits-Battle Frontend Environment Variables
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.development for local dev
# 2. Copy this file to .env.production for production
# 3. Fill in your actual values
# 4. Never commit .env files to Git
#
# cp .env.example .env.development
# cp .env.example .env.production
# ============================================

# ============================================
# API Configuration
# ============================================
# Backend API URL
# Local development:
VITE_API_URL=http://localhost:8000

# Production (update with your actual backend URL):
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_URL=https://your-ec2-ip

# ============================================
# Optional: Feature Flags
# ============================================
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false

# ============================================
# Optional: External Services
# ============================================
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_GA_TRACKING_ID=your-google-analytics-id
